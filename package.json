{
  "name": "tiger-data-app",
  "packageManager": "yarn@4.18.0",
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "nanoid": "^6.0.2",
    "precommit-hook": "^3.0.0",
    "prettier": "3.9.9",
    "rollup": "^4.64.0",
    "vite": "^8.0.0",
    "vite-plugin-ruby": "^5.2.5",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@rails/actioncable": "^7.2.400",
    "@rollup/plugin-inject": "^5.0.5",
    "@types/keyv": "^4.2.0",
    "@types/picomatch": "^4.0.3",
    "@types/rollup": "^0.54.0",
    "@types/supports-color": "^10.0.0",
    "@types/yaml": "^1.9.7",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^14.4.0",
    "bootstrap": "^5.3.8",
    "browserslist": "^4.29.3",
    "datatables": "^1.10.18",
    "datatables.net": "^3.1.3",
    "datatables.net-dt": "^3.1.3",
    "datatables.net-vue3": "^3.0.8",
    "glob": "^13.0.6",
    "happy-dom": "^20.14.5",
    "jquery": "^3.7.1",
    "less": "^4.9.1",
    "lodash": "^4.18.1",
    "lux-design-system": "^7.14.1",
    "minimatch": "10.2.6",
    "nanoid": "^6.0.2",
    "vite-plugin-rails": "^0.6.0",
    "vue": "^3.5.43",
    "vue3-select-component": "^1.0.1",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "lint": "eslint 'app/javascript/**/*.js'",
    "lint-staged": "lint-staged",
    "test": "vitest run --coverage",
    "test:dev": "vitest",
    "validate": "npm ls",
    "validate-license": "bundle exec rake dev_license:expiration_check"
  },
  "lint-staged": {
    "app/*rb": "bundle exec rubocop -a",
    "config/*rb": "bundle exec rubocop -a",
    "lib/*rb": "bundle exec rubocop -a",
    "lib/*rake": "bundle exec rubocop -a",
    "spec/*rb": "bundle exec rubocop -a",
    "*.js": "eslint --fix",
    "*.md": "prettier --write",
    "*css": "prettier --write",
    "*js": "prettier --write",
    "*.yml": "prettier --write"
  },
  "pre-commit": [
    "lint",
    "validate",
    "test"
  ],
  "allowScripts": {}
}
