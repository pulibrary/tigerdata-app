{
  "name": "tiger-data-app",
  "packageManager": "yarn@4.18.0",
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "nanoid": "^6.0.1",
    "precommit-hook": "^3.0.0",
    "prettier": "3.9.6",
    "rollup": "^4.63.1",
    "vite": "^8.2.0",
    "vite-plugin-ruby": "^5.2.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@rails/actioncable": "^7.2.302",
    "@rollup/plugin-inject": "^5.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "bootstrap": "^5.3.8",
    "browserslist": "^4.28.8",
    "datatables": "^1.10.18",
    "datatables.net": "^3.0.3",
    "datatables.net-dt": "^2.3.8",
    "datatables.net-vue3": "^3.0.8",
    "glob": "^13.0.6",
    "jquery": "^3.6.3",
    "lodash": "^4.18.1",
    "lux-design-system": "^7.12.0",
    "minimatch": "10.2.6",
    "nanoid": "^6.0.1",
    "vite-plugin-rails": "^0.6.0",
    "vue": "^3.5.42"
  },
  "scripts": {
    "lint": "eslint 'app/javascript/**/*.js'",
    "lint-staged": "lint-staged",
    "test": "vitest run --coverage",
    "test:dev": "vitest",
    "validate": "npm ls",
    "validate-license": "bundle exec rake dev_license:expiration_check"
  },
  "lint-staged": {
    "app/*rb": "bundle exec rubocop -a",
    "config/*rb": "bundle exec rubocop -a",
    "lib/*rb": "bundle exec rubocop -a",
    "lib/*rake": "bundle exec rubocop -a",
    "spec/*rb": "bundle exec rubocop -a",
    "*.js": "eslint --fix",
    "*.md": "prettier --write",
    "*css": "prettier --write",
    "*js": "prettier --write",
    "*.yml": "prettier --write"
  },
  "pre-commit": [
    "lint",
    "validate",
    "test"
  ]
}
