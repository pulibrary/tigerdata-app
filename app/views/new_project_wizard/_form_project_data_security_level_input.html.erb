<div class="form-field data-security-level">
  <%= render partial: "/new_project_wizard/form_field_label",
           locals: {field_label: "Data Security Level", field_sub_label: "Required"} %>
  <div class="input-frame">
    <div class="security-level-input">
      <div class="horizontal-frame">
        <div class="vertical-frame">
          <data-security-level
            :options="<%= DataSecurityLevelPresenter.select_options.to_json %>"
            :default-value="<%= data_security_level %>">
            <template v-slot:hidden-input="{ selectedItem }">
              <input type="hidden" name="request[data_security_level]" :value="selectedItem" class="selected-item"></input>
            </template>

          </data-security-level>
          <div class="horizontal-frame error-and-count">
            <div class="input-error">
                <%= data_security_level_error %>
            </div>
          </div>
          <p class="storage-tooltip">
          Select the appropriate classification for the data to be contained in your project. For more information, see the <a class="storage-tooltip" href="https://protectingourinfo.princeton.edu/classify" target="_blank" onclick="log_plausible_security_classification()">Princeton Security Classification Guide</a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
