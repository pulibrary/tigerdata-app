<div id="requests-listing">
  <% if @presenter.requests_to_approve.count > 0 %>
    <div class="table">
      <table id="requests-listing" width="100%" role="table"> <!-- width is needed to override datatables calculation -->
        <thead>
          <tr class="project heading screenreader-only">
            <th scope="col">display</th>
            <th scope="col">title</th>
            <th scope="col">status</th>
            <th scope="col">type</th>
            <th scope="col">role</th>
            <th scope="col">download</th>
            <th scope="col">activity</th>
            <th scope="col">quota usage</th>
          </tr>
        </thead>
        <tbody>
          <%= render :partial => "request_list_view", :collection => @presenter.requests_to_approve, :as => :request %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
