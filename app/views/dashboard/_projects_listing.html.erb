<% if projects.count == 0 %>
  <%= render :partial => "startup_page" %>
<% else %>
  <div class="table">
    <table id="<%= table_id %>" width="100%" role="table"> <!-- width is needed to override datatables calculation -->
      <thead>
        <tr class="project heading screenreader-only">
          <th scope="col">display</th>
          <th scope="col">title</th>
          <th scope="col">status</th>
          <th scope="col">type</th>
          <th scope="col">role</th>
          <th scope="col">download</th>
          <th scope="col">activity</th>
          <th scope="col">quota usage</th>
        </tr>
      </thead>
      <tbody>
        <%= render :partial => "project_list_view", :collection => projects.each_with_index, :as => :project %>
      </tbody>
    </table>
  </div>
<% end %>

